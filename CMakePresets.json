{
  "version": 3,
  "configurePresets": [
    {
      "name": "win64-cross",
      "displayName": "Windows 64-bit Clang-MSVC Cross-Compile",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{HOME}/.local/share/Geode/cross-tools/clang-msvc-sdk/clang-msvc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GEODE_TARGET_PLATFORM": "Win64"
      }
    }
  ]
}